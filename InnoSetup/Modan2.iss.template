#define AppVersion "{{VERSION}}"
#define BuildNumber GetEnv('BUILD_NUMBER')

[Setup]
; Product identity. NEVER change this value: Inno keys upgrade detection, the
; uninstall entry and {app} resolution off it, so a new AppId makes every
; existing installation invisible to the installer and leaves it behind.
; The doubled leading brace is Inno's escape for a literal "{", not a typo.
AppId={{46308C1B-18AE-4B0D-B029-41CF44660599}
AppName=Modan2
AppVersion={#AppVersion}
AppPublisher=PaleoBytes
; Per-user install: no elevation, so {localappdata} and {userprograms} always
; resolve to the invoking user rather than to whoever consented to UAC.
PrivilegesRequired=lowest
; {userpf} is the per-user Program Files: %LOCALAPPDATA%\Programs. Local rather
; than Roaming because the onedir payload is ~130 MB and would otherwise sync
; with the user profile on domain-joined machines, and under Programs\ rather
; than directly in %LOCALAPPDATA% so the application does not sit among the data
; folders (Temp, Packages, Microsoft) that live there.
DefaultDirName={userpf}\PaleoBytes\Modan2
UninstallDisplayIcon={app}\Modan2.exe
OutputDir={{DIST_PATH}}\..\InnoSetup\Output
; Use more conservative compression to reduce AV heuristics
Compression=lzma/normal
SolidCompression=no

OutputBaseFilename=Modan2_v{#AppVersion}_build{#BuildNumber}_Installer

; Shown as a page during installation. GPL-3.0 rather than the MIT of the source
; tree: what is being installed includes PyQt5, which is GPL-or-commercial, so
; the binary as a whole is GPL-3.0. build.py stages this file into dist/Modan2.
; See THIRD-PARTY-NOTICES.md.
LicenseFile={{DIST_PATH}}\Modan2\LICENSES\GPL-3.0.txt

[Files]
; ignoreversion on the whole payload, and it is not optional.
;
; Without it Inno decides per file whether the installed copy is already new
; enough, by comparing the binary version resource. Every CI build stamped
; 0.0.0.0 (build.py generated that from a template it could never find), so on
; upgrade Inno saw "not older" and kept the existing Modan2.exe. The installer
; reported success and the previous build went on launching -- found installing
; 0.2.0-beta.3 over beta.2, and true of every upgrade before it.
;
; build.py now stamps a real, rising version, but this flag stays: the payload
; is ours, it is replaced wholesale on every install, and there is no case where
; keeping a file from the previous version is what we want. Relying on the
; numbers alone would put the same silent failure one mistake away.
;
; Include main executable
Source: "{{DIST_PATH}}\Modan2\Modan2.exe"; DestDir: "{app}"; Flags: ignoreversion

; Include all other files and directories
Source: "{{DIST_PATH}}\Modan2\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs

; Example datasets
Source: "{{DIST_PATH}}\ExampleDataset\*"; DestDir: "{%userprofile}\PaleoBytes\Modan2\ExampleDataset"; Flags: recursesubdirs createallsubdirs


[Run]
Filename: "{app}\Modan2.exe"; Flags: postinstall shellexec

[Code]
// --- Detect installations made before the AppId/per-user change -------------
//
// Releases up to 0.2.0-beta.1 had no AppId, so Inno fell back to AppName and
// registered itself as "Modan2_is1". They also installed in admin mode, which
// puts that key under HKLM. This installer is per-user (HKCU) with a GUID
// AppId, so Inno cannot see those installations and will happily install
// alongside them.
//
// Leaving both in place is not merely untidy. Two entries in [Icons] and
// [Files] are literal paths outside {app} and are therefore SHARED by both
// installations:
//
//   {userprograms}\PaleoBytes\Modan2                  (Start Menu shortcut)
//   {%userprofile}\PaleoBytes\Modan2\ExampleDataset   (inside the user's data)
//
// Installing the new version overwrites both, but the old uninstall log still
// lists them. Uninstalling the old version *afterwards* therefore deletes the
// shortcut that now points at the new build, and removes the example datasets
// from the user's data directory. Hence: uninstall first, then install.

const
  LegacyUninstallKey = 'Software\Microsoft\Windows\CurrentVersion\Uninstall\Modan2_is1';

// Looks in every registry view the old installer could have written to. A
// 32-bit-mode Inno install on 64-bit Windows lands in the 32-bit view, but do
// not assume it. Accessing a 64-bit view on 32-bit Windows raises, so guard.
function FindLegacyUninstaller(var Command: String): Boolean;
begin
  Result := True;
  if RegQueryStringValue(HKLM32, LegacyUninstallKey, 'UninstallString', Command) then Exit;
  if RegQueryStringValue(HKCU32, LegacyUninstallKey, 'UninstallString', Command) then Exit;
  if IsWin64 then
  begin
    if RegQueryStringValue(HKLM64, LegacyUninstallKey, 'UninstallString', Command) then Exit;
    if RegQueryStringValue(HKCU64, LegacyUninstallKey, 'UninstallString', Command) then Exit;
  end;
  Result := False;
  Command := '';
end;

function LegacyStillRegistered(): Boolean;
var
  Ignored: String;
begin
  Result := FindLegacyUninstaller(Ignored);
end;

// The old uninstaller relaunches itself from a temp copy, so Exec can return
// before the work is done. Wait on the registry key disappearing instead of on
// the process, and give up rather than hang if something goes wrong.
function WaitForLegacyRemoval(): Boolean;
var
  Waited: Integer;
begin
  Waited := 0;
  while (Waited < 120000) and LegacyStillRegistered() do
  begin
    Sleep(500);
    Waited := Waited + 500;
  end;
  Result := not LegacyStillRegistered();
end;

function RemoveLegacyInstall(): Boolean;
var
  Command: String;
  ResultCode: Integer;
begin
  Result := False;
  if not FindLegacyUninstaller(Command) then
    Exit;

  if not Exec(RemoveQuotes(Command), '/SILENT /NORESTART /SUPPRESSMSGBOXES', '',
              SW_SHOW, ewWaitUntilTerminated, ResultCode) then
  begin
    MsgBox('The previous version''s uninstaller could not be started.' + #13#10#13#10 +
           'Please remove Modan2 from Settings > Apps, then run this installer again.',
           mbError, MB_OK);
    Exit;
  end;

  Result := WaitForLegacyRemoval();
  if not Result then
    MsgBox('The previous version does not appear to have been removed.' + #13#10#13#10 +
           'Please remove Modan2 from Settings > Apps, then run this installer again.',
           mbError, MB_OK);
end;

function InitializeSetup(): Boolean;
var
  Answer: Integer;
begin
  Result := True;

  // Nothing below runs for a fresh install: no key, no prompt.
  if LegacyStillRegistered() then
  begin
    Answer := MsgBox('An older version of Modan2 is installed.' + #13#10#13#10 +
                     'It should be removed first. If it is uninstalled later it will ' +
                     'take the Start Menu shortcut and the example datasets with it, ' +
                     'even though the new version is using them.' + #13#10#13#10 +
                     'Your datasets, images and preferences are stored separately and ' +
                     'are not affected.' + #13#10#13#10 +
                     'Remove the older version now?',
                     mbConfirmation, MB_YESNOCANCEL);

    if Answer = IDCANCEL then
    begin
      Result := False;
      Exit;
    end;

    if Answer = IDYES then
      Result := RemoveLegacyInstall();
    // IDNO: continue and install alongside it, which is what the warning above
    // describes. The user was told; respect the choice.
  end;

  if Result then
  begin
    // Create a specific Start Menu group
    if not DirExists(ExpandConstant('{userprograms}\PaleoBytes')) then
      CreateDir(ExpandConstant('{userprograms}\PaleoBytes'));
  end;
end;

[Icons]
Name: "{userprograms}\PaleoBytes\Modan2"; Filename: "{app}\Modan2.exe"
