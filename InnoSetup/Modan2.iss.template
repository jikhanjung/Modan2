#define AppVersion "{{VERSION}}"
#define BuildNumber GetEnv('BUILD_NUMBER')

[Setup]
; Product identity. NEVER change this value: Inno keys upgrade detection, the
; uninstall entry and {app} resolution off it, so a new AppId makes every
; existing installation invisible to the installer and leaves it behind.
; The doubled leading brace is Inno's escape for a literal "{", not a typo.
AppId={{46308C1B-18AE-4B0D-B029-41CF44660599}
AppName=Modan2
AppVersion={#AppVersion}
AppPublisher=PaleoBytes
; Per-user install: no elevation, so {localappdata} and {userprograms} always
; resolve to the invoking user rather than to whoever consented to UAC.
PrivilegesRequired=lowest
; Local, not Roaming: the onedir payload is ~130 MB and would otherwise sync
; with the user profile on domain-joined machines.
DefaultDirName={localappdata}\PaleoBytes\Modan2
UninstallDisplayIcon={app}\Modan2.exe
OutputDir={{DIST_PATH}}\..\InnoSetup\Output
; Use more conservative compression to reduce AV heuristics
Compression=lzma/normal
SolidCompression=no

OutputBaseFilename=Modan2_v{#AppVersion}_build{#BuildNumber}_Installer

[Files]
; Include main executable
Source: "{{DIST_PATH}}\Modan2\Modan2.exe"; DestDir: "{app}"

; Include all other files and directories
Source: "{{DIST_PATH}}\Modan2\*"; DestDir: "{app}"; Flags: recursesubdirs createallsubdirs

; Example datasets
Source: "{{DIST_PATH}}\ExampleDataset\*"; DestDir: "{%userprofile}\PaleoBytes\Modan2\ExampleDataset"; Flags: recursesubdirs createallsubdirs


[Run]
Filename: "{app}\Modan2.exe"; Flags: postinstall shellexec

[Code]
function InitializeSetup(): Boolean;
begin
  // Create a specific Start Menu group
  if not DirExists(ExpandConstant('{userprograms}\PaleoBytes')) then
    CreateDir(ExpandConstant('{userprograms}\PaleoBytes'));

  Result := True;
end;

[Icons]
Name: "{userprograms}\PaleoBytes\Modan2"; Filename: "{app}\Modan2.exe"
