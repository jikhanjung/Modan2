#: ../../../../../../mnt/d/projects/Modan2/docs/manual/faq.rst:20
msgid "Statistical analysis (PCA, CVA, MANOVA)"
msgstr "통계 분석 (PCA, CVA, MANOVA)"

#: ../../../../../../mnt/d/projects/Modan2/docs/manual/faq.rst:21
